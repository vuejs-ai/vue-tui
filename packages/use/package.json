    "typescript": "^6.0.3",
    "unplugin-vue": "catalog:",
    "vite-plus": "catalog:",
    "vue": "^3.4.0",
    "vue-tsc": "catalog:"
  },
  "peerDependencies": {
    "@vue-tui/runtime": "workspace:^",
    "vue": "^3.4.0"
  }
