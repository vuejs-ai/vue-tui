{
  "name": "@vue-tui/vite",
  "version": "0.3.0",
  "description": "Vite plugin for vue-tui: in-process terminal dev server with HMR.",
  "license": "MIT",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vp pack",
    "dev": "vp pack --watch",
    "test": "vp test",
    "check:type": "tsc --noEmit",
    "prepublishOnly": "vp run build"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@vue-tui/runtime": "workspace:*",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "@vitejs/plugin-vue-jsx": "5.1.5",
    "@vue-tui/runtime": "0.3.0",
    "unplugin-vue": "7.2.0",
    "vite": "8.2.1"
  },
  "peerDependenciesMeta": {
    "@vitejs/plugin-vue-jsx": {
      "optional": true
    },
    "unplugin-vue": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  }
}
